# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
/dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# embed/dist is committed on purpose: it is what go:embed reads, so a Go build
# never needs node installed. The bare "dist" pattern above matched it too,
# which is why CI failed with "pattern all:dist: no matching files found".
!embed/dist
!embed/dist/**
